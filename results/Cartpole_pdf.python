from fpdf import FPDF
import os

# Create results folder if it doesn't exist
os.makedirs("results", exist_ok=True)

pdf = FPDF()
pdf.set_auto_page_break(auto=True, margin=15)
pdf.add_page()

pdf.set_font("Arial", "B", 16)
pdf.cell(0, 10, "CartPole True Swing-Up RL Report", ln=True, align="C")
pdf.ln(10)

# Section 1: Overview
pdf.set_font("Arial", "B", 12)
pdf.cell(0, 10, "1. Project Overview", ln=True)
pdf.set_font("Arial", "", 11)
pdf.multi_cell(0, 8, (
    "Objective: Train an RL agent to swing up and stabilize an inverted pendulum.\n"
    "Environment: CartPoleTrueSwingUp (custom continuous control environment in Python/Matplotlib).\n"
    "Algorithm: PPO (Proximal Policy Optimization) from Stable-Baselines3.\n"
    "Key Deliverables:\n"
    " - Trained model (models/ppo_true_swingup)\n"
    " - Training curves (results/plots/)\n"
    " - Video demonstration (results/video/ppo_true_swingup.mp4)"
))
pdf.ln(5)

# Section 2: Environment Details
pdf.set_font("Arial", "B", 12)
pdf.cell(0, 10, "2. Environment Details", ln=True)
pdf.set_font("Arial", "", 11)
pdf.multi_cell(0, 8, (
    "State: [x, x_dot, theta, theta_dot]\n"
    "Action: Continuous force applied to cart in [-1, 1], scaled by max_force=20.\n"
    "Initial condition: Random initial angle of pendulum.\n"
    "Termination: Cart moves out of bounds (x_threshold=3.0) or max steps reached (max_steps=800).\n"
    "Reward design:\n"
    " - Energy shaping: reward based on deviation from desired pendulum energy.\n"
    " - Upright bonus: exponential bonus for being close to upright.\n"
    " - Penalties: large cart displacement and high velocities penalized."
))
pdf.ln(5)

# Section 3: Training Details
pdf.set_font("Arial", "B", 12)
pdf.cell(0, 10, "3. Training Details", ln=True)
pdf.set_font("Arial", "", 11)
pdf.multi_cell(0, 8, (
    "Algorithm: PPO with MlpPolicy.\n"
    "Hyperparameters:\n"
    " - learning_rate = 3e-4\n"
    " - gamma = 0.99\n"
    " - ent_coef = 0.05\n"
    " - n_steps = 2048\n"
    " - batch_size = 64\n"
    " - total_timesteps = 800,000\n"
    "Results:\n"
    " - Training reward curves (plot saved in results/plots/)\n"
    " - Success rate on random initial angles: 7/10"
))
pdf.ln(5)

# Section 4: Observations
pdf.set_font("Arial", "B", 12)
pdf.cell(0, 10, "4. Observations", ln=True)
pdf.set_font("Arial", "", 11)
pdf.multi_cell(0, 8, (
    " - Early episodes: pendulum barely moves, cart drifts slowly.\n"
    " - Mid-training: pendulum starts swinging, cart oscillates.\n"
    " - Final policy: pendulum swings up quickly and stabilizes upright for multiple episodes.\n"
    "Challenges:\n"
    " - Tuning reward weights was crucial to avoid cart drifting out of bounds.\n"
    " - Random initial angles introduce variability in stabilization."
))
pdf.ln(5)

# Section 5: Future Work / Improvements
pdf.set_font("Arial", "B", 12)
pdf.cell(0, 10, "5. Future Work / Improvements", ln=True)
pdf.set_font("Arial", "", 11)
pdf.multi_cell(0, 8, (
    " - Train with longer episodes or more timesteps for higher stability.\n"
    " - Explore other RL algorithms: SAC, TD3 for potentially smoother control.\n"
    " - Use Isaac Sim / Lab for 3D simulation and more realistic physics.\n"
    " - Implement domain randomization for robustness to different pole lengths or masses."
))
pdf.ln(5)

# Section 6: Conclusion
pdf.set_font("Arial", "B", 12)
pdf.cell(0, 10, "6. Conclusion", ln=True)
pdf.set_font("Arial", "", 11)
pdf.multi_cell(0, 8, (
    "Successfully trained PPO agent to swing up and stabilize pendulum.\n"
    "Video demonstrates agent stabilizing from multiple random initial conditions.\n"
    "Reward design and tuning were key factors in achieving high success rate."
))

# Save PDF
pdf.output("results/CartPole_True_SwingUp_Report.pdf")
print("PDF report generated: results/CartPole_True_SwingUp_Report.pdf")

